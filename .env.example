# Sao chep file nay thanh .env va thay cac placeholder bang cau hinh local.
# Khong commit file .env that hoac mat khau PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/timetable_ga
APP_NAME=Timetable GA API

# Thoi gian song cua phien dang nhap, tinh bang phut (480 phut = 8 gio).
AUTH_SESSION_TTL_MINUTES=480

# De false khi chay HTTP local; dat true khi trien khai qua HTTPS.
AUTH_COOKIE_SECURE=false

# Cac origin frontend duoc gui cookie phien, phan cach bang dau phay.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Tuy chon: database rieng cho Playwright E2E that. Runner se tu suy ra
# timetable_ga_e2e tu DATABASE_URL neu bo trong bien nay.
# E2E_DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/timetable_ga_e2e
